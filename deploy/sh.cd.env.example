# /opt/sh.cd/sh.cd.env — 服务的环境变量 (systemd EnvironmentFile), 含密钥, 不进仓库

# 只监听本机, 由反向代理转发, 反代要用访客真实 IP 覆盖 X-Real-IP。Caddy 示例:
#   sh.cd {
#   	reverse_proxy 127.0.0.1:3410 {
#   		header_up X-Real-IP {client_ip}
#   	}
#   }
HOST=127.0.0.1
PORT=3410

# CleanIP API: IP 情报与批量归属。key 与 origin 成对填写
CLEANIP_API=
CLEANIP_API_KEY=
CLEANIP_ORIGIN=

# DNS 出口检测: 一次性子域所在的域, 权威 NS 的事件接口 (逗号分隔) 与令牌
DNS_PROBE_ZONE=
DNS_PROBE_NS_URLS=
DNS_PROBE_TOKEN=

# 结果页 (sh.cd/results/…) 保存天数, 默认 365; 存在 $DATA_DIR/results
# RESULTS_TTL_DAYS=365
